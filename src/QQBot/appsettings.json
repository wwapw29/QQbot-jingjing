      "FactSignalWords": [
        "喜欢", "讨厌", "我是", "我叫", "家住", "住在", "生日", "明天", "周末",
        "约定", "打算", "计划", "想要", "需要", "记得", "告诉", "介绍",
        "千万", "别忘", "考试", "工作", "学校", "结婚", "养了", "买"

        "Regex": ""  // 正则提取表达式（Strategy=regex 时用）
      }
    },
    "Memory": {
      "DbPath": "data/bot.db",  // SQLite 数据库路径
      "HistoryRetentionDays": 30,  // 聊天历史保留天数
      "EnableAutoMemory": true,  // 自动记忆开关
      "MaxMemoriesPerTurn": 8,  // 每轮注入长期记忆条数

      "AutoInjectGroupHistory": false,  // true=被@自动拉群记录注入(移除get_chat_history工具); false=外置按需拉取
      // 私聊场景附加提示
      "PrivateExtra": "你与对方正处于一对一的私密环境，可以更随意、更亲近，回复可以稍长一些。",
      // 群聊场景附加提示
      "GroupExtra": "\u4F60\u73B0\u5728\u6B63\u5904\u4E8E\u7FA4\u804A\u4E2D\uFF0C\u7FA4\u91CC\u6709\u5176\u4ED6\u4EBA\u5728\u770B\uFF0C\u6CE8\u610F\u516C\u5171\u573A\u5408\u5F97\u4F53\uFF1A\u8BED\u6C14\u514B\u5236\u3001\u56DE\u590D\u5C3D\u91CF\u7B80\u6D01\uFF0C\u4E0D\u8981\u5237\u5C4F\u3002\u8BB0\u4F4F\u4F60\u73B0\u5728\u6B63\u5728QQ\u7FA4\u804A\u4E2D\u3002\u5982\u679C\u5F53\u524D\u60C5\u51B5\u4F60\u9700\u8981\u4E86\u89E3\u7FA4\u4E2D\u66FE\u7ECF\u7684\u804A\u5929\u8BB0\u5F55\uFF0C\u5219\u8C03\u7528\u5DE5\u5177\u0022get_chat_history\u0022\u3002",
      "ReplyExtraction": {
        "Strategy": "delimiter",  // 回复提取策略（reasoningContent/delimiter/regex）

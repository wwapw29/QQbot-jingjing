    "ComfyUI": {
"BaseUrl": "http://127.0.0.1:8188",  // ComfyUI 服务地址
      "WorkflowPath": "ComfyUI/Workflows/静静用的流.json",  // ComfyUI workflow 模板路径（相对运行目录）
      "PositiveNodeId": "319",  // 正面提示词写入节点 ID
      "PositiveValueKey": "value",  // 正面字段名（text/value）

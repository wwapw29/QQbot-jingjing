<Window x:Class="DesktopPet.UI.InputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="对静静说"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        Topmost="True" WindowStartupLocation="Manual"
        Deactivated="OnDeactivated">

    <Border Margin="12" CornerRadius="10" BorderThickness="1"
            Background="#F2FFFFFF" BorderBrush="#552B2B33" Padding="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.3" Color="#000000" />
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <TextBox x:Name="Input" Width="260" FontSize="14" Padding="6,4"
                     FontFamily="Microsoft YaHei UI" BorderThickness="0" Background="Transparent"
                     VerticalContentAlignment="Center"
                     KeyDown="OnKeyDown" />
            <Button x:Name="SendButton" Content="发送" Margin="8,0,0,0" Padding="12,4"
                    FontFamily="Microsoft YaHei UI" FontSize="13"
                    Click="OnSendClick" />
        </StackPanel>
    </Border>
</Window>

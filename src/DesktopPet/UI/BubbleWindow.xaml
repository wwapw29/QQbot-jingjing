<Window x:Class="DesktopPet.UI.BubbleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="bubble"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        ShowActivated="False" Focusable="False" Topmost="True"
        MouseLeftButtonDown="OnClickHide">

    <!-- 气泡：白底圆角 + 小尾巴，点一下消失；支持文字 + 一张图片。
         两条尾巴：她贴屏幕顶边时气泡要翻到她脚下方，这时得用朝上的那条 -->
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Path x:Name="TailTop" Grid.Row="0" HorizontalAlignment="Left" Visibility="Collapsed"
              Data="M 0,9 L 14,9 L 7,0 Z" StrokeThickness="1" />

        <Border x:Name="BubbleBorder" Grid.Row="1"
                CornerRadius="12" BorderThickness="1" Padding="12,9"
                MaxWidth="320">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.28" Color="#000000" />
            </Border.Effect>
            <StackPanel>
                <Image x:Name="BubbleImage" Visibility="Collapsed"
                       Stretch="Uniform" StretchDirection="DownOnly"
                       Margin="0,0,0,6" HorizontalAlignment="Center" />
                <TextBlock x:Name="BubbleText" TextWrapping="Wrap" LineHeight="21" />
            </StackPanel>
        </Border>

        <Path x:Name="TailBottom" Grid.Row="2" HorizontalAlignment="Left"
              Data="M 0,0 L 14,0 L 7,9 Z" StrokeThickness="1" />
    </Grid>
</Window>

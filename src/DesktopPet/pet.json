{
  "name": "静静",
  "assetDir": "assets/placeholder",
  "scale": 1.0,
  "alwaysOnTop": true,
  "locked": false,
  "clickThroughInGame": true,
  "breath": true,

  "actions": {
    "idle": { "frames": [ "idle/1.png", "idle/2.png" ], "fps": 1.2, "loop": true },
    "talk": { "frames": [ "talk/1.png", "talk/2.png" ], "fps": 5.5, "loop": true },
    "thinking": { "frames": [ "idle/2.png" ], "fps": 1, "loop": true },
    "startup": { "frames": [], "fps": 4, "loop": true },
    "error": { "frames": [], "fps": 4, "loop": true },
    "happy": { "frames": [ "happy/1.png", "happy/2.png" ], "fps": 4, "loop": true, "triggers": [ "开心", "高兴", "嘿嘿", "哈哈" ], "weight": 1 }
  },

  "backend": {
    "enabled": true,
    "baseUrl": "http://127.0.0.1:7088",
    "token": "",
    "timeoutSeconds": 180,
    "replyGapMs": 900,
    "inboxPollMs": 3000
  },

  "snap": {
    "enabled": true,
    "threshold": 36,
    "animate": true
  },

  "bubble": {
    "foreground": "#FF2B2B33",
    "background": "#F2FFFFFF",
    "border": "#66C77FB0",
    "fontFamily": "Microsoft YaHei UI",
    "fontSize": 14,
    "maxWidth": 320,
    "baseSeconds": 4,
    "secondsPerChar": 0.25,
    "maxSeconds": 0,
    "cornerRadius": 12
  }
